# ----------------------------------------------------------------------------
# JZac Lead Generator - environment variables
# 100% FREE STACK: no API keys and no credit card required anywhere.
# Local dev: copy this file to ".env" and fill in the values.
# Production: add these in Vercel -> Project -> Settings -> Environment Variables
# ----------------------------------------------------------------------------

# Secret used to sign login tokens (JWT). Use a long random string.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Postgres connection string from Neon (free, no card). REQUIRED in production.
# Use the POOLED connection string (host contains "-pooler"). See README.
# Leave blank for local testing and the app falls back to an in-memory store
# (data is lost on restart).
POSTGRES_URL=

# Seed admin account, created automatically on first run if it doesn't exist.
ADMIN_EMAIL=admin@jzacdesigns.com
ADMIN_PASSWORD=change-this-now
ADMIN_NAME=JZac Admin

# ----------------------------------------------------------------------------
# NOTE: There is NO Google or Anthropic key here on purpose - discovery uses
# free OpenStreetMap data and pitches use built-in templates. If you ever want
# AI-written pitches later, add ANTHROPIC_API_KEY and wire it into
# api/ai/pitch.js (that requires a small amount of prepaid credit).
# ----------------------------------------------------------------------------
