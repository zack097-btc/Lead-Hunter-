# ----------------------------------------------------------------------------
# JZac Lead Generator - environment variables
# 100% FREE STACK: no API keys and no credit card required anywhere.
# Local dev: copy this file to ".env" and fill in the values.
# Production: add these in Vercel -> Project -> Settings -> Environment Variables
#
# THIS FILE IS PUBLIC. It is committed to a public repository, so it must never
# contain a real value or a usable default. It once shipped a working admin
# password; anyone who read the repo could sign in as admin. Placeholders only.
# ----------------------------------------------------------------------------

# Secret used to sign login tokens (JWT). Long random string, kept private.
# Anyone who knows this can forge a login token for ANY account, including the
# admin, without needing a password. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Postgres connection string from Neon (free, no card). REQUIRED in production.
# Use the POOLED connection string (host contains "-pooler"). See README.
# Leave blank for local testing and the app falls back to an in-memory store
# (data is lost on restart).
POSTGRES_URL=

# ---- the admin account -----------------------------------------------------
# These two ARE the admin credential. There is no default and no password-reset
# screen: if both are set, the account is created on next start, and if it
# already exists its password is reset to match and its role set to admin.
#
# That means two useful things:
#   - Forgotten the admin password? Change ADMIN_PASSWORD here, redeploy, done.
#   - Registered on your phone as a normal rep? Put THAT email in ADMIN_EMAIL
#     and the account is promoted, keeping its id and its history.
#
# If either is blank, NO admin account exists. That is deliberate: an app with
# no admin is an inconvenience, an app with a publicly-known admin is a breach.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=JZac Admin

# ---- who may sign up -------------------------------------------------------
# Set this and new accounts must supply the code on the signup screen. Leave it
# blank and signup is OPEN to anyone who finds the URL - fine while nobody knows
# it exists, not fine once it is handed to reps. Change it whenever somebody
# leaves; existing accounts keep working.
INVITE_CODE=

# ----------------------------------------------------------------------------
# NOTE: There is NO Google or Anthropic key here on purpose - discovery uses
# free OpenStreetMap data and pitches use built-in templates. If you ever want
# AI-written pitches later, add ANTHROPIC_API_KEY and wire it into
# api/ai/pitch.js (that requires a small amount of prepaid credit).
# ----------------------------------------------------------------------------
